# ---- LLM -------------------------------------------------------------
# groq (free tier) or claude (paid)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
# Check console.groq.com/docs/models for the current model list
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- Storage -----------------------------------------------------------
# atlas (MongoDB Atlas Search + Vector Search) or memory (no DB, lost on restart)
STORE=atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=spelunk
VECTOR_INDEX_NAME=vector_index
TEXT_INDEX_NAME=text_index

# ---- Embeddings (EMBED_DIM must match numDimensions in the Atlas index) --
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# ---- Indexing ------------------------------------------------------------
DEFAULT_REPO=https://github.com/morluto/rea
MAX_FILE_KB=320
MAX_FILES=6000
INDEX_TESTS=false
# extra glob patterns to skip, comma separated, e.g. examples/**,**/*.snap
EXTRA_EXCLUDE=

# ---- Retrieval -----------------------------------------------------------
TOP_K=6
CANDIDATES=40
RRF_K=60

# ---- API -----------------------------------------------------------------
READ_ONLY=false
